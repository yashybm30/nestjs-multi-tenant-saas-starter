{
  "name": "nestjs-multi-tenant-saas-starter",
  "version": "0.1.0",
  "private": true,
  "description": "nestjs multi tenant saas starter",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "pretest": "npm run build",
    "pretest:integration": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "prom-client": "^15.1.3",
    "express": "^5.1.0",
    "zod": "^4.6.7",
    "@prisma/client": "^6.19.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "express-session": "^1.18.2",
    "connect-redis": "^9.0.0",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/express-session": "^1.18.2",
    "prisma": "^6.19.0"
  },
  "overrides": {
    "multer": "^2.4.1",
    "js-yaml": "^5.4.1",
    "deepmerge-ts": "^8.0.0"
  }
}
